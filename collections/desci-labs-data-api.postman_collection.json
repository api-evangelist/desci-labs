        {
          "id": "b11862a5-6eb7-4abf-9ffe-cb13de7fab74",
          "name": "Get IPFS folder tree for the research object's root by dPID",
          "request": {
            "name": "Get IPFS folder tree for the research object's root by dPID",
            "description": {
              "content": "Resolves the given dPID to its manifest and returns the directory tree for the `root` component's CID.\nUse `depth` to limit recursion for performance; use `full` for complete traversal.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "data",
                "dpid",
                ":dpid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Specific version index (e.g., `v3` or `2`) to resolve before reading the root CID"
                },
                {
                  "disabled": false,
                  "key": "concurrency",
                  "value": "8",
                  "description": "Maximum number of concurrent DAG fetches"
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "<string>",
                  "description": "Maximum directory depth to traverse. Use `full` for complete traversal, or a number (0=root only)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dpid",
                  "description": "(Required) The dPID identifier (numeric)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

          "name": "Get IPFS folder tree for a specific path within a dPID",
          "request": {
            "name": "Get IPFS folder tree for a specific path within a dPID",
            "description": {
              "content": "Resolves the given dPID and navigates to a specific path within the root component.\nFor example: /v2/data/dpid/827/root/code will return just the 'code' directory.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "data",
                "dpid",
                ":dpid",
                "*"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
